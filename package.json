{
  "name": "cybage-tracker",
  "version": "1.0.0",
  "description": "A cross-platform desktop application built with Electron.js that automates the tracking of attendance logs and work hours for Cybage employees. This application securely scrapes swipe data from the Cybage MIS portal and Work-From-Home (WFH) activity from ESPlus, replacing traditional terminal outputs with a clean, user-friendly Graphical User Interface (GUI).",
  "main": "./out/main/index.js",
  "author": {
    "name": "Cybage Software Pvt Ltd",
    "email": "support@cybage.com"
  },
  "homepage": "https://cybage.com",
  "desktopName": "com.cybage.attendance-scraper",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "release": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@tailwindcss/vite": "^4.3.1",
    "electron-updater": "^6.3.9",
    "puppeteer": "^25.2.1",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^2.1.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "vite": "^7.2.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pavankokane/cybage-tracker.git"
  },
  "build": {
    "appId": "com.cybage.attendance-scraper",
    "productName": "Cybage Tracker",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "pavankokane",
        "repo": "cybage-tracker"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "resources/icon.png",
      "category": "Utility",
      "maintainer": "Cybage Software Pvt Ltd <support@cybage.com>",
      "syncDesktopName": true
    }
  }
}
